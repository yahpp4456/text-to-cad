{
  "name": "cad-chat",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "本機網頁版『對話式 CAD 產圖』 — Claude Agent SDK(綁訂閱)驅動 text-to-cad pipeline。",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node src/server/server.mjs --dev",
    "build": "vite build",
    "serve": "node src/server/server.mjs",
    "start": "node src/server/server.mjs",
    "electron:dev": "electron .",
    "bake-auth": "node scripts/bake-auth.mjs",
    "merge-lessons": "node scripts/merge-lessons.mjs",
    "build:packaged": "node scripts/bake-auth.mjs && vite build",
    "dist": "node scripts/bake-auth.mjs && vite build && electron-builder --win --config electron-builder.yml",
    "dist:personal": "node scripts/bake-auth.mjs --allow-oauth && vite build && electron-builder --win --config electron-builder.yml"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.260",
    "gifenc": "^1.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "react-markdown": "^9",
    "remark-gfm": "^4",
    "vite": "^7.3.2"
  }
}
